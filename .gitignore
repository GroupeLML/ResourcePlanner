# Python bytecode/cache artifacts
__pycache__/
*.py[cod]

.ruff_cache/
.pypirc

# Python virtual environments
.venv/
.venv-web/
.venv-importer/

# IDE / editor temp files
tempCodeRunnerFile.py

# Streamlit
.streamlit/secrets.toml

# Docker/site-local environment files
.env
deploy/synology/.env

# RessourcePlanner local configuration and per-user preferences
app_config.json
user_preferences.json
user_preferences.json.tmp
planning_pure_validation.json
planning_pure_validation.json.tmp

# Local SQL databases used for development/migrations
resourceplanner.db
*.db
*.sqlite
*.sqlite3

# React/Vite local artifacts
frontend/node_modules/
frontend/dist/
frontend/.env
frontend/.env.local
frontend/playwright-report/
frontend/test-results/

# Local cutover reports (may contain workbook metadata/diagnostics)
cutover_report.json
cutover_reports/

# Local confidential-term denylist used by tools/privacy_scan.py
.privacy_terms.local

# Local code-signing material (never commit private keys or encoded PFX data)
signing-output/
*.pfx
*.p12
*.pfx.base64
*.pfx.base64.txt

# Excel workbooks and temporary lock files
*.xlsx
*.xlsm
~$*.xlsx
~$*.xlsm

# Manual ERP CSV exports
imports/*.csv

# Dev Cockpit local artifacts
dev-cockpit/.venv/
dev-cockpit/frontend/node_modules/
dev-cockpit/frontend/dist/

# Dev Cockpit local settings when running outside Docker
dev-cockpit/**/dev-cockpit-data/
