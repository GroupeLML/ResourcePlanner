# Copier vers deploy/synology/.env sur le NAS. Ne jamais committer le fichier réel.
RESOURCEPLANNER_IMAGE_TAG=git-REMPLACER_PAR_SHA
RESOURCEPLANNER_HTTP_PORT=8080
RESOURCEPLANNER_BIND_ADDRESS=0.0.0.0
RESOURCEPLANNER_LOG_LEVEL=info

# SQL Server externe en production après validation de #162.
# Exemple de forme seulement; ne pas mettre de credential réel dans Git.
RESOURCEPLANNER_DATABASE_URL=

# Production: OIDC par défaut. Les valeurs réelles restent uniquement sur le NAS.
RESOURCEPLANNER_AUTH_MODE=oidc
RESOURCEPLANNER_ALLOW_LOCAL_AUTH_NETWORK=false
RESOURCEPLANNER_DEV_USER_SWITCHER=false
RESOURCEPLANNER_OIDC_DISCOVERY_URL=
RESOURCEPLANNER_OIDC_CLIENT_ID=
RESOURCEPLANNER_OIDC_CLIENT_SECRET=
RESOURCEPLANNER_OIDC_REDIRECT_URI=
RESOURCEPLANNER_OIDC_SCOPES=openid profile email
RESOURCEPLANNER_OIDC_SECURE_COOKIE=true
RESOURCEPLANNER_OIDC_AUTO_PROVISION=false

# Dépendances externes optionnelles.
RESOURCEPLANNER_ACUMATICA_BASE_URL=
RESOURCEPLANNER_ACUMATICA_ACCESS_TOKEN=
RESOURCEPLANNER_ACUMATICA_ENDPOINT=Default
RESOURCEPLANNER_ACUMATICA_VERSION=

RESOURCEPLANNER_M365_TENANT_ID=
RESOURCEPLANNER_M365_CLIENT_ID=
RESOURCEPLANNER_M365_CLIENT_SECRET=
RESOURCEPLANNER_M365_MAILBOX=

# Clé maîtresse Fernet pour les secrets administrés dans l'application.
# Générer une valeur propre à l'installation et la conserver uniquement sur le NAS.
RESOURCEPLANNER_CONFIG_ENCRYPTION_KEY=

# CSP du frontend Nginx. Ajouter les origines Teams seulement lorsqu'elles sont validées.
RESOURCEPLANNER_FRAME_ANCESTORS='self'
