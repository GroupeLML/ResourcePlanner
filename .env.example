# Docker local / développement. Copier vers .env si des valeurs doivent être surchargées.
RESOURCEPLANNER_HTTP_PORT=8080
RESOURCEPLANNER_BIND_ADDRESS=127.0.0.1
RESOURCEPLANNER_IMAGE_TAG=local

# Identification visuelle du runtime. Conserver PROD par défaut et utiliser DEV dans .env.dev.
RESOURCEPLANNER_ENVIRONMENT=PROD

# SQLite local par défaut. Laisser vide uniquement si docker-compose.yml garde sa valeur par défaut.
RESOURCEPLANNER_DATABASE_URL=sqlite+pysqlite:////data/resourceplanner.db

# Le mode local est volontairement autorisé sur le réseau Docker interne pour le développement.
# Le bootstrap ADMIN local ne nécessite aucun AppUser seedé : il est matérialisé en AppUser dev
# au premier accès API authentifié après migration, afin de fournir un acteur stable aux mutations/audits.
# Le Dev User Switcher reste un outil opt-in et n'est pas requis pour accéder à l'application.
# Ne pas réutiliser ce réglage comme configuration de production exposée sur le LAN
# ni comme mécanisme break-glass de production.
RESOURCEPLANNER_AUTH_MODE=local
RESOURCEPLANNER_ALLOW_LOCAL_AUTH_NETWORK=true
RESOURCEPLANNER_DEV_USER_SWITCHER=false
RESOURCEPLANNER_LOCAL_AUTH_NAME=Administrateur local
RESOURCEPLANNER_LOCAL_AUTH_ROLES=ADMIN

# Production uniquement avec RESOURCEPLANNER_AUTH_MODE=oidc.
# Le credential est créé explicitement avec le profile Docker "ops"; le secret doit rester hors Git.
RESOURCEPLANNER_BREAK_GLASS_ENABLED=false
RESOURCEPLANNER_BREAK_GLASS_LOGIN=
RESOURCEPLANNER_BREAK_GLASS_SECRET=

RESOURCEPLANNER_LOG_LEVEL=info
RESOURCEPLANNER_FRAME_ANCESTORS='self'

# Acumatica OData projets. Laisser vide pour garder l'intégration désactivée.
# Le mot de passe et le nom de compte réel restent uniquement dans le .env local/secrets.
RESOURCEPLANNER_ACUMATICA_BASE_URL=
RESOURCEPLANNER_ACUMATICA_USERNAME=
RESOURCEPLANNER_ACUMATICA_PASSWORD=
RESOURCEPLANNER_ACUMATICA_PAGE_SIZE=100
RESOURCEPLANNER_ACUMATICA_TIMEOUT_SECONDS=30

# ERP scheduler / evidence / operations (643A + 643B + 643C).
# Safe default: automatic synchronization stays disabled until an operator completes
# docs/ERP_SYNC_OPERATIONS_RUNBOOK.md and receives explicit Product Owner authorization.
RESOURCEPLANNER_ERP_SYNC_ENABLED=false
RESOURCEPLANNER_ERP_SYNC_TIME=00:00
RESOURCEPLANNER_ERP_SYNC_TIMEZONE=America/Toronto
RESOURCEPLANNER_ERP_SYNC_CATCHUP_HOURS=4
RESOURCEPLANNER_ERP_SYNC_MIN_SOURCE_RATIO=0.50
RESOURCEPLANNER_ERP_SYNC_MIN_PROJECTS=1
RESOURCEPLANNER_ERP_SYNC_MIN_TASK_ROWS=1
RESOURCEPLANNER_ERP_SYNC_MAX_EVIDENCE_MIB=256
RESOURCEPLANNER_ERP_SYNC_EVIDENCE_BUDGET_MIB=2048
RESOURCEPLANNER_ERP_SYNC_FAILURE_RETENTION_DAYS=14
RESOURCEPLANNER_ERP_SYNC_HISTORY_DAYS=90
RESOURCEPLANNER_ERP_SYNC_FRESHNESS_SLA_HOURS=30

# Required before 643C production activation. Keep the real Fernet key outside Git
# and inject it through the VM/Compose secret or environment handling.
RESOURCEPLANNER_CONFIG_ENCRYPTION_KEY=

# Dev Cockpit local/dev uniquement (profile Docker "dev-tools").
# Ne pas provisionner ces variables dans la configuration de production de la VM Ubuntu.
# Créer un token GitHub en lecture seule et le garder uniquement dans le .env local/dev.
# Ne jamais committer une valeur de token.
DEV_COCKPIT_GITHUB_TOKEN=
DEV_COCKPIT_REPOSITORY=tchi99/RessourcePlanner
DEV_COCKPIT_ROADMAP_ISSUE=55
DEV_COCKPIT_STALLED_AFTER_MINUTES=30
DEV_COCKPIT_HTTP_PORT=8081
